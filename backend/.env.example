# Server Configuration
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/matrix-fx
# Or use MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/matrix-fx

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Market Data API
# Choose one or both:
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FXPRO_API_KEY=your_fxpro_api_key_here
FXPRO_API_URL=https://api.fxpro.com

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Trading Configuration
MAX_POSITION_SIZE=10000
RISK_PER_TRADE=0.02
MIN_SIGNAL_STRENGTH=0.7

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,exp://localhost:19000

# Log Level
LOG_LEVEL=debug
