{
  "expo": {
    "name": "Matrix Fx",
    "slug": "matrix-fx",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.gravyvogan.matrixfx"
    },
    "android": {
      "package": "com.gravyvogan.matrixfx",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "matrixfx",
    "plugins": [
      "expo-font"
    ]
  }
}
